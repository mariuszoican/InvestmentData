lambda_std           = scale(player.arrival_rate)[,1],
finquiz_std          = scale(player.num_correct_answers)[,1],
gender_female        = as.integer(player.gender == "Female"),
age_std              = scale(player.age)[,1],
overconfidence_std   = scale(overconfidence)[,1],
data_value_std       = scale(data_value)[,1],
payoff_diff_std      = scale(payoff_diff)[,1],
self_assessment_std  = scale(playerself_assesment)[,1],
premium              = as.integer(playerframing == "Premium"),
alpha_lambda         = alpha_std * lambda_std,
premium_data         = premium * playerdata_available,
data_alpha           = playerdata_available * alpha_std,
data_lambda          = playerdata_available * lambda_std,
data_quiz            = playerdata_available * finquiz_std,
data_course          = playerdata_available * playercourse_financial,
wtp_diff             = post_wtp - pre_wtp,
datavalue_data       = data_value_std * playerdata_available,
overconfidence_data  = overconfidence_std * playerdata_available,
finquiz_data         = finquiz_std * playerdata_available,
plrpgr               = plr - pgr,
data_alpha_lambda    = playerdata_available * alpha_lambda
)
