# Create a grouped identifier for clustering
df <- df %>%
group_by(subsessionround_number, playersession_name, data_first) %>%
mutate(round_session = cur_group_id()) %>%
ungroup()
# Create a grouped identifier for clustering
df <- df %>%
group_by(subsession.round_number, player.session_name, data_first) %>%
mutate(round_session = cur_group_id()) %>%
ungroup()
# Define control variable sets
controls   <- c("playercourse_financial", "data_course", "overconfidence_std", "premium", "premium_data", "finquiz_std", "data_value_std", "age_std", "gender_female", "data_first", "playertrading_experience")
controls_2 <- c("playercourse_financial", "overconfidence_std", "premium", "finquiz_std", "age_std", "gender_female", "data_first", "playertrading_experience", "payoff_diff_std")
controls_3 <- c("playercourse_financial", "data_course", "overconfidence_std", "premium", "premium_data", "finquiz_std", "age_std", "gender_female", "data_first", "playertrading_experience")
#--------------------------------------------------
# Table 1: Willingness to Pay (WTP) regressions
#--------------------------------------------------
df3 <- filter(df, subsessionround_number == 3)
#--------------------------------------------------
# Table 1: Willingness to Pay (WTP) regressions
#--------------------------------------------------
df3 <- filter(df, subsession.round_number == 3)
mod_wtp1 <- feols(
as.formula(paste0("post_wtp ~ alpha_std + lambda_std + alpha_lambda + ", paste(controls_2, collapse = " + "))),
data      = df3,
weights   = ~playercertainty,
fixef     = ~subsessionround_number,
cluster   = ~participantcode + round_session
)
mod_wtp1 <- feols(
as.formula(paste0("post_wtp ~ alpha_std + lambda_std + alpha_lambda + ", paste(controls_2, collapse = " + "))),
data      = df3,
weights   = ~playercertainty,
fixef     = ~subsession.round_number,
cluster   = ~participant.code + round_session
)
